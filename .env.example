# ==============================================================
# CareAfter Environment Configuration (.env.example)
# Copy this file to `.env` and fill in your real credentials.
# NEVER commit the `.env` file to GitHub!
# ==============================================================

# Supabase Client Configuration (Publicly accessible in browser bundle)
# Obtain these from: Supabase Dashboard -> Project Settings -> API
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key

# Server-Side Gemini API Key (Strictly server-side; NEVER exposed in React/browser)
# Obtain from: Google AI Studio (https://aistudio.google.com/)
GEMINI_API_KEY=your-gemini-api-key
